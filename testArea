@Bean
public SpringBus cxfBus() {
    var bus = new SpringBus();
    bus.setProperty("use.async.http.conduit", Boolean.TRUE);
    // ... your existing org.apache.cxf.transport.http.async.* properties ...
    bus.setExtension(new ProxyAuthFixingConduitFactory(bus), HTTPConduitFactory.class);
    return bus;
}

/** Works around CXF seeding HC5's AuthCache with an un-initialised BasicScheme
 *  for the proxy, which breaks Basic proxy auth on HTTPS CONNECT (CXF 4.1.x / HC5 5.4.x). */
private static class ProxyAuthFixingConduitFactory extends AsyncHTTPConduitFactory {
    ProxyAuthFixingConduitFactory(Bus bus) {
        super(bus);
    }

    @Override
    protected void adaptClientBuilder(HttpAsyncClientBuilder builder) {
        builder.disableAuthCaching();
    }
}
